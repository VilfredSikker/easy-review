            "type": [
              "string",
              "null"
            ]
          },
          "files": {
            "additionalProperties": {
              "type": "string"
            },
            "default": null,
            "description": "Required for `upload`: exactly one entry, `{ \"<output_file>\": \"<diagram JSON>\" }`\nusing the filename from `action=prepare`'s `kit.output_file`.",
