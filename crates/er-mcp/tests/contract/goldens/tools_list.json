              "null"
            ]
          },
          "number": {
            "default": null,
            "format": "uint64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "pr_url": {
            "default": null,
            "type": [
              "string",
              "null"
            ]
          },
          "project_id": {
            "default": null,
            "type": [
              "string",
              "null"
            ]
          },
          "prompt": {
            "default": null,
            "description": "For `kind=custom`: the diagram instructions (required on `prepare`; pinned onto\nthe sidecar on `upload`, overriding whatever `prompt` the uploaded JSON carries).",
            "type": [
              "string",
              "null"
            ]
          },
          "ref": {
            "default": null,
            "description": "Universal ref: PR URL, worktree path, `owner/repo`, `owner/repo#N`, branch name, or bare PR number.",
